{
  "name": "pyrra/configops",
  "description": "The undo and evidence layer for WordPress settings.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "pyrra",
      "email": "felix@pyrra.net"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "squizlabs/php_codesniffer": "3.13.6"
  },
  "autoload": {
    "psr-4": {
      "ConfigOps\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:compatibility": "phpcs --standard=PHPCompatibilityWP --extensions=php --runtime-set testVersion 8.2-8.5 configops.php uninstall.php src templates tests"
  }
}
