{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=wp-mail-smtp",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": {
    "username": "admin",
    "password": "password"
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "ConfigOps live demo",
        "wp_mail_smtp_activation_prevent_redirect": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
