        "caption": "Installing the supported WP Mail SMTP demo"
      },
      "options": {
        "activate": true,
        "humanReadableName": "WP Mail SMTP 4.9.0"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "wp_mail_smtp": {
          "mail": {
            "from_email": "admin@localhost.com",
            "from_email_force": true,
            "from_name": "ConfigOps live demo",
            "from_name_force": false,
